  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.mergen</groupId>
  <artifactId>mergen-sdk</artifactId>
  <version>2.7.1</version>
  <packaging>aar</packaging>
  <name>Mergen ID Card Scanner SDK</name>
  <description>Commercial Android SDK for scanning and verifying Kyrgyz national ID cards. Includes drop-in CameraX UI (Compose + XML), headless MergenScanner engine, and Mergen.verify() for two-sided document cross-validation.</description>
  <url>https://github.com/DanielPHP01/MergenSDK-Android</url>
  <licenses>
    <license>
      <name>Mergen Commercial License</name>
      <url>https://mergen.kz/sdk/license</url>
      <distribution>repo</distribution>
      <comments>Proprietary — redistribution or reverse-engineering prohibited without written consent.</comments>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>DanielPHP01</id>
      <name>Mergen SDK Team</name>
      <email>sdk@mergen.kz</email>
      <organization>Mergen</organization>
      <organizationUrl>https://mergen.kz</organizationUrl>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/DanielPHP01/MergenSDK-Android.git</connection>
    <developerConnection>scm:git:ssh://github.com/DanielPHP01/MergenSDK-Android.git</developerConnection>
    <url>https://github.com/DanielPHP01/MergenSDK-Android</url>
  </scm>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>androidx.compose</groupId>
        <artifactId>compose-bom</artifactId>
        <version>2024.06.00</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
